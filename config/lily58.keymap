#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#include "zmk-helpers/helper.h"
// Source desired key-position labels
#include "zmk-helpers/key-labels/lily58.h"
// Source unicode-chars for desired languages
#include "zmk-helpers/unicode-chars/russian.dtsi"

#define _BT_SEL_KEYS_                                                        \
      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR

#define ___ &trans
#define XXX &none

// Layout is a port of https://github.com/argenkiwi/kenkyo (the original
// Kenkyo project) onto this lily58 hardware. `extend` and `fumbol` are
// Kenkyo's layers (minus its one-shot modifier chords, which are
// intentionally not ported); `system` is new here, reached by holding both
// `extend` and `fumbol` together, same tri-layer mechanism the old
// silakka54 config used for `sys`.
//
// This particular board only has 3 of lily58's 4 thumb keys per hand — the
// innermost key on each hand (LH0, RH0) doesn't physically exist.
#define DEF 0
#define EXTEND 1
#define FUMBOL 2
#define SYSTEM 3

/* Timeless homerow mods */

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5 LF0 LF1 LF2 LF3 LF4 LF5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5 RF0 RF1 RF2 RF3 RF4 RF5  // right hand
#define THUMBS LH3 LH2 LH1 LH0 RH0 RH1 RH2 RH3                            // thumbs

#define QUICK_TAP_MS 175

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS)                                 \
  ZMK_HOLD_TAP(NAME, bindings = <HOLD>, <TAP>; flavor = "balanced";            \
               tapping-term-ms = <280>; quick-tap-ms = <QUICK_TAP_MS>;         \
               require-prior-idle-ms = <150>; hold-trigger-on-release;         \
               hold-trigger-key-positions = <TRIGGER_POS>;)

MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS) // Left-hand HRMs.
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS) // Right-hand HRMs.

// Leftmost home-row key: tap for Caps Lock, hold for Hyper (all 4 mods).
ZMK_HOLD_TAP(caps_hyper, bindings = <&kp>, <&kp>; flavor = "tap-preferred";
             tapping-term-ms = <200>; quick-tap-ms = <QUICK_TAP_MS>;)

/* Tri-layer: holding extend + fumbol together activates system */
ZMK_CONDITIONAL_LAYER(system, EXTEND FUMBOL, SYSTEM)

/* Bluetooth: tap does nothing, hold 3s clears the current profile's bond */
ZMK_MACRO(bt_clear, bindings = <&bt BT_CLR>;)

ZMK_HOLD_TAP(bt_clear_ht, bindings = <&bt_clear>, <&none>;
             flavor = "tap-preferred"; tapping-term-ms = <3000>;)

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |  `  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   \   |
// | TAB |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   [   |
// |CAPS/| A/A | S/G | D/S  | F/C  |  G   |                   |  H   | J/C   | K/S   | L/G  |  ;/A  |   '   |
// |HYPER|Z/Ctl|X/Alt|  C   |  V   |  B   |   xxx  |  |  xxx  |  N   |  M    |  ,    |./Alt |  //Ctl|   ]   |
//                   | none | Sft  |extend|  xxx   |  |  xxx  |fumbol|space | none |
//
// One-key chords (active on default + extend + fumbol): W+E->Esc, I+O->Bspc, X+C->Tab, ,+.->Enter
// Rightmost column (top to bottom) and top-left corner are ASCII hosts for
// the OS's Russian keyboard layout to remap by physical position.
// Only 3 of 4 thumb keys per hand exist on this board (innermost missing).
            bindings = <
&kp GRAVE            &kp N1        &kp N2      &kp N3       &kp N4       &kp N5                             &kp N6     &kp N7       &kp N8       &kp N9      &kp N0         &kp BSLH
&kp TAB              &kp Q         &kp W       &kp E        &kp R        &kp T                              &kp Y      &kp U        &kp I        &kp O       &kp P          &kp LBKT
&caps_hyper LC(LS(LA(LGUI))) CAPS  &hml LALT A   &hml LGUI S &hml LSHFT D &hml LCTRL F &kp G                              &kp H      &hmr RCTRL J &hmr RSHFT K &hmr LGUI L &hmr LALT SEMI &kp SQT
&none                &hml LCTRL Z  &hml LALT X &kp C        &kp V        &kp B            XXX        XXX    &kp N      &kp M        &kp COMMA    &hmr LALT DOT &hmr RCTRL FSLH &kp RBKT
                                                XXX          &kp LSHFT    &mo EXTEND       XXX               XXX        &mo FUMBOL   &kp SPACE    XXX
            >;
        };

        extend_layer {
// ------------------------------------------------------------------------------------------------------------
// Kenkyo's `extend` layer, held via the extend thumb key.
// |     |     |     |      |      |      |                   |      |       |       |      |       |       |
// |     |     |     |      |      | TAB  |                   | PGUP | HOME  |  UP   |  END |  INS  |       |
// |     | Alt | Gui |  Sft | Ctl  | RET  |                   | PGDN | LEFT  | DOWN  | RIGHT|  Esc  |       |
// |     |     |     |      |      | Menu |   xxx  |  |  xxx  |      | BSPC  | SPACE | DEL  |       |       |
// Media keys used to live on the bottom row here; moved to `system`.
            display-name = "extend";
            bindings = <
&trans &trans        &trans        &trans        &trans        &trans                              &trans     &trans      &trans      &trans     &trans   &trans
&trans &trans        &trans        &trans        &trans        &kp TAB                             &kp PG_UP  &kp HOME    &kp UP      &kp END    &kp INS  &trans
&trans &kp LALT       &kp LGUI      &kp LSHFT     &kp LCTRL     &kp RET                              &kp PG_DN  &kp LEFT    &kp DOWN    &kp RIGHT  &kp ESC  &trans
&trans &trans         &trans        &trans        &trans        &kp K_APPLICATION &trans     &trans   &trans    &kp BSPC    &kp SPACE   &kp DEL    &trans  &trans
                                    &trans        &trans        &trans           &trans     &trans   &trans     &trans      &trans
            >;
        };

        fumbol_layer {
// ------------------------------------------------------------------------------------------------------------
// Kenkyo's `fumbol` layer (Function/Numbers/Symbols), held via either
// thumb's fumbol key. F-keys fill the number row (F1-F12). Shift+number
// symbols sit on the row above home row.
// |  F1 |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
// |     |  !  |  @  |  #   |  $   |  %   |                   |  ^   |   &   |   *   |  (   |   )   |       |
// |     |1/Alt|2/Gui|3/Sft |4/Ctl |  5   |                   |  6   | 7/Ctl | 8/Sft | 9/Gui| 0/Alt |       |
// |     |</Ctl|`/Alt|  -   |  =   |      |   xxx  |  |  xxx  |      |   '   |   [   | ]/Alt| \/Ctl |       |
//
// Fumbol-only chords: S+D->KP-, D+F->KP+, J+K->KP/, K+L->KP*, J+L->.
// (S+D+F "🔢₌" 3-key chord from the source not ported — unclear/garbled glyph)
            display-name = "fumbol";
            bindings = <
&kp F1 &kp F2               &kp F3        &kp F4        &kp F5        &kp F6                          &kp F7     &kp F8             &kp F9             &kp F10           &kp F11              &kp F12
&trans &kp EXCL              &kp AT        &kp HASH      &kp DLLR      &kp PRCNT                       &kp CARET  &kp AMPS           &kp ASTRK          &kp LPAR          &kp RPAR             &trans
&trans &hml LALT N1         &hml LGUI N2  &hml LSHFT N3 &hml LCTRL N4 &kp N5                           &kp N6     &hmr RCTRL N7      &hmr RSHFT N8      &hmr LGUI N9      &hmr LALT N0         &trans
&trans &hml LCTRL NON_US_BSLH &hml LALT GRAVE &kp MINUS   &kp EQUAL     &trans         &trans   &trans  &trans     &kp SQT            &kp LBKT           &hmr LALT RBKT    &hmr LCTRL BSLH      &trans
                                            &trans        &trans        &trans         &trans   &trans  &trans     &trans             &trans
            >;
        };

        system_layer {
// ------------------------------------------------------------------------------------------------------------
// Reached by holding EXTEND + FUMBOL together. Bluetooth on the number
// row (old silakka54 sys layer), media keys on the home row (moved here
// from extend, one row up from where they used to be).
// |CLR/3s|  1  |  2  |  3   |  4   |  5   |                   |      |       |       |      |       |       |
// |      |     |     |      |      |      |                   |      |       |       |      |       |       |
// |      |Mute |VolDn|VolUp |  PP  |      |                   |      |       |       |      |       |       |
// |      |     |     |      |      |      |   xxx  |  |  xxx  |      |       |       |      |       |       |
            display-name = "system";
            bindings = <
&bt_clear_ht 0 0 &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4     &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                   &trans &trans &trans &trans &trans &trans
&trans &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PP &trans           &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans     &trans &trans &trans &trans &trans &trans
                     &trans &trans &trans &trans &trans    &trans &trans &trans
            >;
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        // Kenkyo's four one-key chords, valid on default, extend, and
        // fumbol (the individual taps differ per layer; the chord output
        // doesn't). Row labels here follow zmk-helpers' lily58 matrix
        // order, where LT/RT is the number row, LM/RM the QWERTY row,
        // LB/RB the home row, and LF/RF the bottom row.
        combo_esc {
            timeout-ms = <35>;
            key-positions = <LM2 LM3>; // W + E
            layers = <DEF EXTEND FUMBOL>;
            bindings = <&kp ESC>;
        };

        combo_bspc {
            timeout-ms = <35>;
            key-positions = <RM2 RM3>; // I + O
            layers = <DEF EXTEND FUMBOL>;
            bindings = <&kp BSPC>;
        };

        combo_tab {
            timeout-ms = <35>;
            key-positions = <LF2 LF3>; // X + C
            layers = <DEF EXTEND FUMBOL>;
            bindings = <&kp TAB>;
        };

        combo_ret {
            timeout-ms = <35>;
            key-positions = <RF2 RF3>; // , + .
            layers = <DEF EXTEND FUMBOL>;
            bindings = <&kp RET>;
        };

        // Fumbol-only math chords from Kenkyo's fhl/fhr chord groups.
        combo_kp_minus {
            timeout-ms = <35>;
            key-positions = <LB2 LB3>; // S + D
            layers = <FUMBOL>;
            bindings = <&kp KP_MINUS>;
        };

        combo_kp_plus {
            timeout-ms = <35>;
            key-positions = <LB1 LB2>; // D + F
            layers = <FUMBOL>;
            bindings = <&kp KP_PLUS>;
        };

        combo_kp_slash {
            timeout-ms = <35>;
            key-positions = <RB1 RB2>; // J + K
            layers = <FUMBOL>;
            bindings = <&kp KP_SLASH>;
        };

        combo_kp_asterisk {
            timeout-ms = <35>;
            key-positions = <RB2 RB3>; // K + L
            layers = <FUMBOL>;
            bindings = <&kp KP_ASTERISK>;
        };

        combo_dot {
            timeout-ms = <35>;
            key-positions = <RB1 RB3>; // J + L
            layers = <FUMBOL>;
            bindings = <&kp DOT>;
        };
    };
};
